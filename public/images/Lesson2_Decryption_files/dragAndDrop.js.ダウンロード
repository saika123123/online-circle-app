    }
    return false;
};

DandD.prototype.onDragleave = function(event) {

	// stop default event
	event.stopPropagation();
	event.preventDefault();

    return false;
};

DandD.prototype.onDragover = function(event) {

	// stop default event
	event.stopPropagation();
	event.preventDefault();
    return false;
};

DandD.prototype.onDrop = function(event) {

	// stop default event
	event.stopPropagation();
	event.preventDefault();

    // type check
	var type = this.dragtype(event);
    if (!type) {
        return false;
    }

    // targetArea
    var section = event.currentTarget;

    // only file
    if (type == 'Files') {

    	// get the file object
    	var files = event.originalEvent.dataTransfer.files;

    	this.filesLength = files.length;
    	// ファイルチェック
    	var uploadFiles = [];
        var index = 0;
        for (var i = 0; i < files.length; i++) {
        	var file = files[i];

        	if (file.name != '.ds_store') {
        		 uploadFiles[index] = file;
        		 index++;
        	}
        }

        //チェックがOKなファイルのみアップロード対象とする
        Array.prototype.push.apply(this.uploadFiles, uploadFiles);

        // 保持最大長を超えたかを判定
        var isOverLimit = false;
        if(this.uploadFiles.length > this.maxFileNum) {
        	isOverLimit = true
        }

        // ファイルが追加された事を通知
        var isOverwrite = false;
        if(this.onDropCb) {
        	isOverwrite = this.onDropCb(isOverLimit);
        }

        // オーバー分を上書きしてよければ上書き
        if(isOverLimit && isOverwrite === true) {
        	this.uploadFiles = this.uploadFiles.slice(0 - this.maxFileNum);
        }
        else if(isOverLimit) {
        	this.uploadFiles = this.uploadFiles.slice(0, this.maxFileNum);
        }
    }

    return false;
};

DandD.prototype.dragtype = function(e) {

	// ドラッグアイテムのタイプをチェック
	var types = e.originalEvent.dataTransfer.types;

	if (this.typesincludes(types, 'Files')) {
        this.realtype = 'Files';
        return 'Files';
    }
    if (this.typesincludes(types, 'url')) {
        this.realtype = 'url';
        return 'url';
    }
    if (this.typesincludes(types, 'text/uri-list')) {
        this.realtype = 'text/uri-list';
        return 'url';
    }
    if (this.typesincludes(types, 'text/html')) {
        this.realtype = 'text/html';
        return 'text/html';
    }
    if (this.typesincludes(types, 'text')) {
        this.realtype = 'text';
        return 'text';
    }
    if (this.typesincludes(types, 'text/plain')) {
        this.realtype = 'text/plain';
        return 'text';
    }
    return false; // No types we can handle
};

//-------------------
// Util
//-------------------
DandD.prototype.wrap = function(cb) {
	var self = this;
	return function() {
		cb.apply(self, arguments);
	}
};

DandD.prototype.typesincludes = function(eventTypes, type) {
    for (var i = 0; i < eventTypes.length; i++) {
        if (eventTypes[i] == type) {
            return true;
        }
    }
    return false;
};
