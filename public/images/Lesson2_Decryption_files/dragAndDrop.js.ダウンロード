
/**
 * ドラッグアンドドロップを設定する
 *
 * @param targetId 領域のID
 * @param maxFileNum 保持するファイル数
 * @param onDropCb ドロップ時のコールバック処理
 * @returns 自インスタンス
 */
function DandD(targetId, emptyItemNum, onDropCb, maxFileNum) {

	this.maxFileNum = 1000;
	this.uploadFiles = [];
	this.filesLength = 0;
	this.onDropCb = null;

	// パラメータを設定
	if(emptyItemNum) {
		for(var i = 0; i < emptyItemNum; i++) {
			this.uploadFiles.push("");
		}
	}

	if(maxFileNum && maxFileNum > 0 && maxFileNum < 10) {
		this.maxFileNum = maxFileNum;
	}
	this.onDropCb = onDropCb;

	// 対象エリアを取得
	var targetArea = $("#" + targetId);

	// 対象エリアが存在しない場合はドラッグ＆ドロップを設定しない
	if($("#" + targetId).length > 0) {

		// 対象エリアにイベントを設定
		targetArea.on("dragenter", this.wrap(this.onDragenter));
		targetArea.on("dragleave", this.wrap(this.onDragleave));
		targetArea.on("dragover", this.wrap(this.onDragover));
		targetArea.on("drop", this.wrap(this.onDrop));
	}
};

//----------------------
// Public メソッド
//----------------------
/**
 * インプット情報を初期化する
 *
 */
DandD.prototype.clear = function() {
	this.uploadFiles = [];
};

/**
 * 保持済みのファイル情報（配列）を取得する
 */
DandD.prototype.getUploadFiles = function() {
	return this.uploadFiles;
};

/**
 * 保持済みのファイル情報（最後の1ファイル）を取得する
 */
DandD.prototype.getUploadFile = function() {
	var file = null;

	// 配列の最後を取得
	var length = this.uploadFiles.length;
	if(length > 0) {
		file = this.uploadFiles[length - 1]
	}

	return file;
};

/**
 * 直近で追加されたファイルの情報を取得する
 */
DandD.prototype.getUploadLatestFiles = function(){
	var allFiles = this.uploadFiles;

	var returnFiles = [];
	var count = allFiles.length - this.filesLength;
	for(var i = count; i <  allFiles.length; i++){
		var file = allFiles[i];
		returnFiles.push(file);
	}

	return returnFiles;
}

DandD.prototype.setFileClear = function(blockArea, clearButton) {
	var me = this;

	var block = "." + blockArea;

	// 削除ボタンの処理を設定
	$("." + clearButton).off("click");
	$("." + clearButton).click(function(event) {
		event.preventDefault();

		// 保存配列から削除
		var clickIndex = $("." + clearButton).index(this);
		me.uploadFiles.splice(clickIndex, 1);

		// 要素を削除
		$(this).closest(block).remove();

		var clearClass = $(this).attr('class');
		var clearItem = /messageDelete/;
		var clearElemnt = clearClass.match(clearItem);
		// 課題提出画面の取消ボタン
		if ("messageDelete" == clearElemnt) {
			clearUploadMessage();
		}
	});
};

